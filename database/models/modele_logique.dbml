Project transport_velo_bordeaux {
  database_type: 'PostgreSQL'
  Note: 'Modele logique derive de pc_captv_p.csv'
}

Table sensor_type {
  code varchar(30) [pk]
  label varchar(120) [not null]
}

Table traffic_zone {
  zone_code integer [pk]
  source_label varchar(30) [not null]
}

Table sensor {
  gid integer [pk]
  ident varchar(30) [not null, unique]
  libelle text [not null]
  type_code varchar(30) [not null]
  zone_code integer [not null]
  latitude numeric(10,7) [not null]
  longitude numeric(10,7) [not null]
  geo_point_source text [not null]
  geo_shape jsonb [not null]
  cdate timestamptz [not null]
  mdate timestamptz [not null]

  indexes {
    type_code
    zone_code
    (latitude, longitude)
  }
}

Table sensor_measurement {
  sensor_gid integer [pk]
  comptage_5m integer
  observed_at timestamptz [not null]
}

Table weather_sensor_clean {
  event_id uuid [pk]
  observed_at timestamptz [not null]
  collected_at timestamptz [not null]
  source varchar(80) [not null]
  temperature_c numeric(6,2)
  humidity_pct numeric(6,2)
  wind_speed_kmh numeric(8,2)
  precipitation_mm numeric(8,2) [not null, default: 0]
  sensor_gid integer [not null]
  sensor_ident varchar(30) [not null]
  sensor_type varchar(30) [not null]
  zone integer [not null]
  sensor_latitude numeric(10,7) [not null]
  sensor_longitude numeric(10,7) [not null]
  sensor_label text [not null]
  comptage_5m integer
  processed_at timestamptz [not null]

  indexes {
    observed_at
    zone
  }
}

Ref: sensor.type_code > sensor_type.code
Ref: sensor.zone_code > traffic_zone.zone_code
Ref: sensor_measurement.sensor_gid - sensor.gid
Ref: weather_sensor_clean.sensor_gid > sensor.gid
